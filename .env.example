# =============================================================================
#  Polybot configuration.  Copy this file to `.env` and fill it in.
#
#      cp .env.example .env
#
#  The real `.env` is git-ignored and MUST NEVER be committed.
# =============================================================================

# --- Wallet -----------------------------------------------------------------
# Your wallet's private key (hex, with or without the leading 0x).
# Generate a fresh one with:   python -m polybot.cli generate-wallet
# NEVER share this value or paste it into a chat / issue / commit.
POLYBOT_PRIVATE_KEY=

# The address that actually holds the USDC used for trading.
# - If you trade directly from your EOA (the key above), leave this blank and
#   it defaults to the key's own address.
# - If you use a Polymarket proxy/deposit wallet, put that address here.
POLYBOT_FUNDER_ADDRESS=

# Signature type for Polymarket:
#   0 = EOA (a normal wallet / raw private key)          <-- most common
#   1 = Email/Magic proxy wallet
#   2 = Browser (Metamask) proxy wallet
POLYBOT_SIGNATURE_TYPE=0

# --- Network ----------------------------------------------------------------
POLYBOT_CLOB_HOST=https://clob.polymarket.com
POLYBOT_CHAIN_ID=137            # 137 = Polygon mainnet

# --- Safety -----------------------------------------------------------------
# DRY_RUN=true  -> paper trading: everything runs, logs what it WOULD do, but
#                  places NO real orders. This is the safe default.
# DRY_RUN=false -> LIVE trading with real money. Only set this once you have
#                  tested in dry-run and funded the wallet.
POLYBOT_DRY_RUN=true
